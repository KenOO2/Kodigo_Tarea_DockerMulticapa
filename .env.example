# =============================================================================
# Variables del ecosistema.  Uso:   cp .env.example .env   y completa los valores.
# El archivo .env NUNCA se sube a Git (está en .gitignore).
# =============================================================================

# ------------------------------- MySQL (servicio `db`) -----------------------
# Estas 4 las lee la imagen oficial mysql:8.0 para crear la base y el usuario.
# Laravel se conecta con MYSQL_USER / MYSQL_PASSWORD (no con root).
MYSQL_ROOT_PASSWORD=cambia_esta_root_password
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_user
MYSQL_PASSWORD=cambia_esta_password

# ------------------------------- Laravel (servicio `backend`) ----------------
APP_NAME="Ecommerce API"
APP_ENV=production
APP_DEBUG=false
APP_URL=http://localhost:8000
LOG_LEVEL=warning

# Clave de cifrado de Laravel. Generar con:
#   docker run --rm php:8.2-cli-alpine php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# Si se deja vacía, el contenedor genera una TEMPORAL (cambia en cada reinicio).
APP_KEY=

# Secreto para firmar los JWT. Generar con:
#   docker run --rm php:8.2-cli-alpine php -r "echo bin2hex(random_bytes(32)).PHP_EOL;"
# Si se deja vacío, se genera uno TEMPORAL (cambia en cada reinicio -> invalida sesiones).
JWT_SECRET=
JWT_TTL=60
JWT_REFRESH_TTL=20160

# true = al arrancar carga usuarios y productos de demostración (idempotente).
DB_SEED=true
CORS_ALLOWED_ORIGINS=*

# ------------------------------- Stripe (modo test) --------------------------
# Llaves en https://dashboard.stripe.com/test/apikeys  (ambas de la MISMA cuenta)
# Publicable (pk_test_...): es pública. La usan el frontend (en build) y el backend.
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Secreta (sk_test_...): SOLO el backend. Nunca en el frontend ni en Git.
STRIPE_SECRET=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: solo si configuras el webhook (https://dashboard.stripe.com/test/webhooks)
STRIPE_WEBHOOK_SECRET=

# ------------------------------- Puertos publicados en el host ---------------
FRONTEND_PORT=3000
API_PORT=8000
# phpMyAdmin (solo con: docker compose --profile tools up -d)
PMA_PORT=8081

# ------------------------------- Frontend (Next.js) --------------------------
# URL de la API tal como la ve el NAVEGADOR (se embebe en el build).
# Debe coincidir con el puerto API_PORT de arriba.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api
