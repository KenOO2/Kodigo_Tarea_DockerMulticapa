# Solo para desarrollo local SIN Docker (npm run dev).
# Con Docker Compose las variables se definen en el .env de la raíz del repo.

# URL base de la API Laravel (incluye /api).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Llave PUBLICABLE de Stripe (pk_test_...). Es pública por diseño.
# Debe ser de la MISMA cuenta de Stripe cuya STRIPE_SECRET usa el backend.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
